{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.14.0/schema.json",
  "name": "iV1",
  "position": {
    "x": 280,
    "y": 95,
    "z": 2000,
    "height": 175,
    "width": 355
  },
  "visual": {
    "visualType": "lineClusteredColumnComboChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "dim_date"
                    }
                  },
                  "Property": "month_short"
                }
              },
              "queryRef": "dim_date.month_short",
              "active": true
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "fact_sales"
                    }
                  },
                  "Property": "Revenue per Day"
                }
              },
              "queryRef": "fact_sales.Revenue per Day"
            }
          ]
        },
        "Y2": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "fact_sales"
                    }
                  },
                  "Property": "Avg Line Value"
                }
              },
              "queryRef": "fact_sales.Avg Line Value"
            }
          ]
        }
      }
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Revenue per day (bars) vs avg line value (line)'"
                }
              }
            }
          }
        }
      ]
    },
    "drillFilterOtherVisuals": true,
    "objects": {
      "valueAxis": [
        {
          "properties": {
            "start": {
              "expr": {
                "Literal": {
                  "Value": "0D"
                }
              }
            },
            "secStart": {
              "expr": {
                "Literal": {
                  "Value": "0D"
                }
              }
            }
          }
        }
      ]
    }
  }
}
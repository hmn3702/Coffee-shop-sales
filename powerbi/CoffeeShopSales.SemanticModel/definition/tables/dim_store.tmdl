table dim_store
	lineageTag: b7669a02-d9f4-4bd7-84d2-3991b2014377

	column store_id
		dataType: int64
		lineageTag: 35a71265-71cf-4fba-9e1d-42fec0ee0160
		summarizeBy: none
		sourceColumn: store_id

	column store_location
		dataType: string
		lineageTag: dbea26e0-6a92-4c8e-8423-c591f0fa7cd0
		summarizeBy: none
		sourceColumn: store_location

	partition dim_store = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "dim_store.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"store_id", Int64.Type}, {"store_location", type text}}, "en-US")
				in
				    Typed

